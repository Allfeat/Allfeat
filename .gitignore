# Generated by Cargo
# will have compiled files and executables
**/target/
# These are backup files generated by rustfmt
**/*.rs.bk

.DS_Store

# The cache for docker container dependency
.cargo/*
!.cargo/config.toml

# The cache for chain data in container
.local

# direnv cache
.direnv

# IDE's related
.idea
.vscode

# Binary folder
bin

# Weights benchmarks files
benchmarking_errors.txt

# Node.js tooling (migration scripts)
node_modules/

# Rehearsal artifacts, regenerated by migration/rehearsal.sh
migration/*.json
migration/genesis-head.hex
migration/scripts/genesis-head.hex

# Locally generated dev chain spec (just build-spec-dev)
chain_spec.json

# LLM
CRUSH.md
